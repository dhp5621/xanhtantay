DATABASE_URL=postgresql://...
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token
CHAT_API_SECRET=your-chat-api-secret
# Shared password for all seeded demo accounts (login page shows it). Default: demo123
DEMO_PASSWORD=demo123

# Platform admin (/admin). Username defaults to "admin".
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Optional: separate secret for the admin cookie (falls back to NEXTAUTH_SECRET)
ADMIN_SESSION_SECRET=

# Brain summary (OpenAI-compatible chat completions). Without CHAT_API_SECRET the
# dashboard writes a rule-based summary for each harvest run.
CHAT_API_URL=https://chat-api.chuyenbienhoa.com/v1/chat/completions
CHAT_API_MODEL=gemini-flash-lite
CHAT_API_SECRET=

# Push notifications (/admin → Thông báo đẩy). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://xanhtantay.vercel.app
# Optional: only needed if "Enhanced push security" is turned on for the Expo project
EXPO_ACCESS_TOKEN=

# Protects /api/cron/cutoff (Vercel Cron, 11:00 UTC = 18:00 Vietnam time)
CRON_SECRET=
