{
  "expo": {
    "name": "Xanh Tận Tay",
    "slug": "xanhtantay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "xanhtantay",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6FBF4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dhp.vkn.xanhtantay"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6FBF4"
      },
      "package": "dhp.vkn.xanhtantay"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Xanh Tận Tay cần truy cập thư viện ảnh để đăng ảnh vườn và ảnh đại diện.",
          "cameraPermission": "Xanh Tận Tay cần dùng camera để chụp ảnh vườn và ảnh đại diện."
        }
      ]
    ]
  }
}
