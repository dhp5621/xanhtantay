{
  "expo": {
    "name": "Xanh Tận Tay",
    "slug": "xanhtantay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "xanhtantay",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6FBF4",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6FBF4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dhp.vkn.xanhtantay",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6FBF4"
      },
      "package": "dhp.vkn.xanhtantay",
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Xanh Tận Tay cần dùng camera để quét mã QR trên hộp rau."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Xanh Tận Tay cần truy cập thư viện để chọn ảnh đại diện, ảnh rau củ và ảnh, video bằng chứng khi trả hàng.",
          "cameraPermission": "Xanh Tận Tay cần dùng camera để chụp ảnh đại diện, ảnh rau củ và quay ảnh, video bằng chứng khi trả hàng.",
          "microphonePermission": "Xanh Tận Tay cần dùng micro khi bạn quay video bằng chứng."
        }
      ],
      "react-native-edge-to-edge",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "49ef7159-e628-42fd-936d-ab549b28dbb0"
      }
    },
    "owner": "huanhoahongso3"
  }
}
